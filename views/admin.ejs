<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Admin Panel - Makank' }) %>
<style>
  .data-table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
  .data-table th, .data-table td { padding: 1rem; text-align: left; border-bottom: 1px solid var(--border-glass); vertical-align: middle; }
  .data-table th { color: var(--text-secondary); font-weight: 600; }
  .data-table tr:hover { background: rgba(255,255,255,0.02); }
  .tab-content { display: none; }
  .tab-content.active { display: block; }
  .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); backdrop-filter: blur(5px); display: none; justify-content: center; align-items: center; z-index: 1000; }
  .modal { background: var(--bg-surface); padding: 2rem; border-radius: 16px; width: 90%; max-width: 500px; border: 1px solid var(--border-glass); }
  .sidebar a { border-radius: 50px; }
  .ticket-badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 50px; font-size: 0.75rem; font-weight: 700; }
  .badge-tickets { background: rgba(0, 245, 255, 0.15); color: var(--accent-cyan); }
  .badge-none { background: rgba(255, 255, 255, 0.05); color: var(--text-secondary); }
  .drop-zone { border: 2px dashed var(--border-glass); border-radius: 12px; padding: 2rem; text-align: center; cursor: pointer; transition: all 0.3s; color: var(--text-secondary); }
  .drop-zone:hover, .drop-zone.dragover { border-color: var(--accent-cyan); background: rgba(0, 245, 255, 0.05); color: var(--accent-cyan); }
  .drop-zone img { max-height: 150px; border-radius: 8px; margin-top: 1rem; }
  .gallery-preview { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1rem; }
  .gallery-preview img { width: 80px; height: 80px; object-fit: cover; border-radius: 8px; border: 1px solid var(--border-glass); }
  .featured-toggle { cursor: pointer; padding: 0.3rem 0.6rem; border-radius: 50px; font-size: 0.75rem; font-weight: 700; border: none; transition: all 0.3s; }
  .featured-on { background: rgba(0, 245, 255, 0.2); color: var(--accent-cyan); }
  .featured-off { background: rgba(255,255,255,0.05); color: var(--text-secondary); }
  
  /* Premium image preview container style */
  .image-preview-container { position: relative; display: inline-block; margin: 5px; }
  .image-preview-container img { width: 90px; height: 90px; object-fit: cover; border-radius: 8px; border: 1px solid var(--border-glass); transition: transform 0.2s, box-shadow 0.2s; }
  .image-preview-container img:hover { transform: scale(1.05); box-shadow: 0 4px 12px rgba(0, 245, 255, 0.3); }
  .image-preview-container .delete-btn { position: absolute; top: -5px; right: -5px; background: var(--error); color: white; border: none; border-radius: 50%; width: 20px; height: 20px; font-size: 14px; font-weight: bold; line-height: 18px; text-align: center; cursor: pointer; padding: 0; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 5px rgba(0,0,0,0.5); transition: background-color 0.2s, transform 0.2s; }
  .image-preview-container .delete-btn:hover { background: #ff1a1a; transform: scale(1.2); }
</style>
<body>
  <div class="bg-blobs"></div>

  <%- include('partials/navbar', { navStyle: 'admin' }) %>

  <main class="container">
    <section>
      <div class="animate"><h1>Dashboard Control <span class="text-gradient">Center</span></h1></div>

      <div class="grid grid-3 mt-4 animate delay-1" style="margin-top: 2rem;">
        <div class="glass card stat-card">
          <h3 style="color: var(--accent-purple);" id="statUsers">0</h3>
          <p>Registered Users</p>
        </div>
        <div class="glass card stat-card">
          <h3 style="color: var(--accent-cyan);" id="statTickets">0</h3>
          <p>Tickets Sold</p>
        </div>
        <div class="glass card stat-card">
          <h3 style="color: black;" id="statRevenue">0 EGP</h3>
          <p>Total Revenue</p>
        </div>
      </div>

      <div class="dashboard-layout mt-4" style="margin-top: 3rem;">
        <div class="sidebar glass animate delay-1" style="padding: 1.5rem; height: fit-content;">
          <a href="#" class="active" onclick="switchAdminTab(event, 'eventsListTab')">Manage Events</a>
          <a href="#" onclick="switchAdminTab(event, 'addMatchTab')">Add Football Match</a>
          <a href="#" onclick="switchAdminTab(event, 'addEventTab')">Add Entertainment Event</a>
          <a href="#" onclick="switchAdminTab(event, 'eventTypesTab')">Event Types</a>
          <a href="#" onclick="switchAdminTab(event, 'usersListTab')">Manage Users</a>
          <a href="#" onclick="switchAdminTab(event, 'bookedTicketsTab')">Booked Tickets</a>
        </div>

        <div class="content flex-1 animate delay-2">

          <!-- ========== MANAGE EVENTS TAB ========== -->
          <div id="eventsListTab" class="glass tab-content active" style="padding: 2rem;">
            <h2>All Events & Matches</h2>
            <h3 style="margin-top: 1.5rem; color: var(--accent-cyan);">Football Matches</h3>
            <div style="overflow-x: auto;">
              <table class="data-table">
                <thead><tr><th>ID</th><th>Match</th><th>Date</th><th>Stadium</th><th>Status</th><th>Featured</th></tr></thead>
                <tbody id="matchesTableBody"></tbody>
              </table>
            </div>
            <div id="matchTablePagination"></div>
            
            <h3 style="margin-top: 2.5rem; color: var(--accent-purple);">Entertainment Events</h3>
            <div style="overflow-x: auto;">
              <table class="data-table">
                <thead><tr><th>ID</th><th>Name</th><th>Date</th><th>Venue</th><th>Type</th><th>Featured</th></tr></thead>
                <tbody id="entertainmentTableBody"></tbody>
              </table>
            </div>
            <div id="eventTablePagination"></div>
          </div>

          <!-- ========== ADD FOOTBALL MATCH TAB ========== -->
          <div id="addMatchTab" class="glass tab-content" style="padding: 2rem;">
            <h2>Add Football Match</h2>
            <form id="matchForm" style="margin-top: 1.5rem;">
              <div class="grid grid-2" style="gap: 1rem;">
                <div class="form-group">
                  <label>Home Team</label>
                  <select id="matchHomeTeam"></select>
                </div>
                <div class="form-group">
                  <label>Away Team</label>
                  <select id="matchAwayTeam"></select>
                </div>
              </div>
              <div class="grid grid-2" style="gap: 1rem;">
                <div class="form-group">
                  <label>Match Date</label>
                  <input type="date" id="matchDate">
                </div>
                <div class="form-group">
                  <label>Kick-off Time</label>
                  <input type="text" id="matchTime" placeholder="e.g. 08:00 PM">
                </div>
              </div>
              <div class="grid grid-2" style="gap: 1rem;">
                <div class="form-group">
                  <label>City</label>
                  <select id="matchCity" style="background: white; color: black;"></select>
                </div>
                <div class="form-group">
                  <label>Stadium</label>
                  <select id="matchStadium" style="background: white; color: black;"></select>
                </div>
              </div>
              <div class="grid grid-2" style="gap: 1rem;">
                <div class="form-group">
                  <label>Match Number</label>
                  <input type="number" id="matchNumber" placeholder="e.g. 6" min="1">
                </div>
                <div class="form-group">
                  <label>Booking Status</label>
                  <select id="matchStatus">
                    <option value="available">Available</option>
                    <option value="closed">Booking Closed</option>
                  </select>
                </div>
              </div>
              <div class="form-group" style="display: flex; align-items: center; gap: 0.5rem; margin-top: 1rem;">
                <input type="checkbox" id="matchFeatured" style="width: auto;">
                <label for="matchFeatured" style="margin: 0; cursor: pointer;">Feature on Home Page</label>
              </div>
              <div class="form-group" style="margin-top: 2rem;">
                <button type="submit" class="btn btn-primary">Create Match</button>
              </div>
            </form>
          </div>

          <!-- ========== ADD ENTERTAINMENT EVENT TAB ========== -->
          <div id="addEventTab" class="glass tab-content" style="padding: 2rem;">
            <h2>Add Entertainment Event</h2>
            <form id="eventForm" style="margin-top: 1.5rem;">
              <div class="form-group">
                <label>Event Name</label>
                <input type="text" id="eventName" placeholder="e.g. Neon Lights World Tour">
              </div>
              <div class="grid grid-2" style="gap: 1rem;">
                <div class="form-group">
                  <label>Event Date</label>
                  <input type="date" id="eventDate">
                </div>
                <div class="form-group">
                  <label>Event Type</label>
                  <select id="eventTypeSelect"></select>
                </div>
              </div>
              <div class="grid grid-2" style="gap: 1rem;">
                <div class="form-group">
                  <label>Venue</label>
                  <input type="text" id="eventVenue" placeholder="e.g. Cairo Festival City">
                </div>
                <div class="form-group">
                  <label>Base Ticket Price (EGP)</label>
                  <input type="number" id="eventPrice" placeholder="e.g. 60" min="0">
                </div>
              </div>
              <div class="form-group">
                <label>Description</label>
                <textarea id="eventDescription" placeholder="Describe what makes this event special..." style="min-height: 100px; resize: vertical;"></textarea>
              </div>
              <div class="form-group">
                <label>Google Maps Link</label>
                <input type="text" id="eventMapUrl" placeholder="Paste a Google Maps link or embed URL">
              </div>
              <div class="form-group">
                <label>Header Image</label>
                <div class="drop-zone" id="headerDropZone" onclick="document.getElementById('headerFileInput').click()">
                  <p>Drag & drop an image here, or click to select</p>
                  <input type="file" id="headerFileInput" accept="image/*" style="display: none;">
                  <div id="headerPreview"></div>
                </div>
              </div>
              <div class="form-group">
                <label>Gallery Images</label>
                <div class="drop-zone" id="galleryDropZone" onclick="document.getElementById('galleryFileInput').click()">
                  <p>Drag & drop images here, or click to select multiple</p>
                  <input type="file" id="galleryFileInput" accept="image/*" multiple style="display: none;">
                </div>
                <div class="gallery-preview" id="galleryPreview"></div>
              </div>
              <div class="form-group" style="display: flex; align-items: center; gap: 0.5rem; margin-top: 1rem;">
                <input type="checkbox" id="eventFeatured" style="width: auto;">
                <label for="eventFeatured" style="margin: 0; cursor: pointer;">Feature on Home Page</label>
              </div>
              <div class="form-group" style="margin-top: 2rem;">
                <button type="submit" class="btn btn-primary">Create Event</button>
              </div>
            </form>
          </div>

          <!-- ========== EVENT TYPES TAB ========== -->
          <div id="eventTypesTab" class="glass tab-content" style="padding: 2rem;">
            <h2>Event Types</h2>
            <div class="form-group" style="margin-top: 1.5rem;">
              <label>Add New Type</label>
              <div style="display: flex; gap: 1rem;">
                <input type="text" id="newTypeInput" placeholder="e.g. Festival, Conference">
                <button class="btn btn-primary" onclick="addEventType()">Add</button>
              </div>
            </div>
            <ul id="eventTypesList" style="margin-top: 1rem; list-style: none; padding: 0;"></ul>
          </div>

          <!-- ========== MANAGE USERS TAB ========== -->
          <div id="usersListTab" class="glass tab-content" style="padding: 2rem;">
            <h2>Manage Users</h2>
            <div style="margin-top: 1.5rem; margin-bottom: 1.5rem;">
              <h3 style="margin-bottom: 1.5rem;">Create Admin Account</h3>
              <form id="createAdminForm">
                <div class="grid grid-3" style="gap: 1rem; align-items: end;">
                  <div class="form-group" style="margin: 0;"><input type="text" id="newAdminName" placeholder="Admin Name"></div>
                  <div class="form-group" style="margin: 0;"><input type="email" id="newAdminEmail" placeholder="Admin Email"></div>
                  <div class="form-group" style="margin: 0;"><input type="password" id="newAdminPassword" placeholder="Secure Password"></div>
                </div>
                <button type="submit" class="btn btn-primary" style="margin-top: 1rem;">Create Admin</button>
              </form>
            </div>
            <div style="overflow-x: auto;">
              <table class="data-table">
                <thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Tickets</th><th>Joined</th><th>Action</th></tr></thead>
                <tbody id="usersTableBody"></tbody>
              </table>
            </div>
            <div id="userTablePagination"></div>
            
            <h3 style="margin-top: 3rem; margin-bottom: 1.5rem;">Registered Admin Accounts</h3>
            <div style="overflow-x: auto;">
              <table class="data-table">
                <thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Action</th></tr></thead>
                <tbody id="adminsTableBody"></tbody>
              </table>
            </div>
          </div>

          <!-- ========== BOOKED TICKETS TAB ========== -->
          <div id="bookedTicketsTab" class="glass tab-content" style="padding: 2rem;">
            <h2>All Booked Tickets</h2>
            <div id="allTicketsContainer" style="margin-top: 1.5rem;"></div>
          </div>

        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer', { footerText: 'Makank Admin Dashboard.' }) %>

  <!-- Edit User Modal -->
  <div class="modal-overlay" id="editUserModal">
    <div class="modal glass">
      <h3>Edit User Credentials</h3>
      <div class="form-group" style="margin-top: 1rem;"><label>Name</label><input type="text" id="editUserName" style="background: white; color: black;"></div>
      <div class="form-group"><label>Email</label><input type="email" id="editUserEmail" style="background: white; color: black;"></div>
      <div class="form-group"><label>New Password</label><input type="text" id="editUserPassword" style="background: white; color: black;"></div>
      <button class="btn btn-primary" onclick="saveUserEdit()">Save Changes</button>
      <button class="btn btn-secondary" onclick="closeModal('editUserModal')">Cancel</button>
    </div>
  </div>

  <!-- Edit Event Type Modal -->
  <div class="modal-overlay" id="editEventTypeModal">
    <div class="modal glass">
      <h3>Edit Event Type</h3>
      <div class="form-group" style="margin-top: 1rem;">
        <label>Type Name</label>
        <input type="text" id="editEventTypeName" style="background: white; color: black;">
      </div>
      <button class="btn btn-primary" onclick="saveEventTypeEdit()">Save Changes</button>
      <button class="btn btn-secondary" onclick="closeModal('editEventTypeModal')">Cancel</button>
    </div>
  </div>

  <!-- Edit Match Modal -->
  <div class="modal-overlay" id="editMatchModal">
    <div class="modal glass" style="max-width: 600px; max-height: 90vh; overflow-y: auto;">
      <h3>Edit Football Match</h3>
      <form id="editMatchForm" style="margin-top: 1rem;">
        <div class="grid grid-2" style="gap: 1rem;">
          <div class="form-group">
            <label>Home Team</label>
            <select id="editMatchHomeTeam" style="background: white; color: black;"></select>
          </div>
          <div class="form-group">
            <label>Away Team</label>
            <select id="editMatchAwayTeam" style="background: white; color: black;"></select>
          </div>
        </div>
        <div class="grid grid-2" style="gap: 1rem;">
          <div class="form-group">
            <label>Match Date</label>
            <input type="date" id="editMatchDate" style="background: white; color: black;">
          </div>
          <div class="form-group">
            <label>Kick-off Time</label>
            <input type="text" id="editMatchTime" placeholder="e.g. 08:00 PM" style="background: white; color: black;">
          </div>
        </div>
        <div class="grid grid-2" style="gap: 1rem;">
          <div class="form-group">
            <label>City</label>
            <select id="editMatchCity" style="background: white; color: black;"></select>
          </div>
          <div class="form-group">
            <label>Stadium</label>
            <select id="editMatchStadium" style="background: white; color: black;"></select>
          </div>
        </div>
        <div class="grid grid-2" style="gap: 1rem;">
          <div class="form-group">
            <label>Match Number</label>
            <input type="number" id="editMatchNumber" min="1" style="background: white; color: black;">
          </div>
          <div class="form-group">
            <label>Booking Status</label>
            <select id="editMatchStatus" style="background: white; color: black;">
              <option value="available">Available</option>
              <option value="closed">Booking Closed</option>
            </select>
          </div>
        </div>
        <div class="form-group" style="display: flex; align-items: center; gap: 0.5rem; margin-top: 1rem;">
          <input type="checkbox" id="editMatchFeatured" style="width: auto;">
          <label for="editMatchFeatured" style="margin: 0; cursor: pointer;">Feature on Home Page</label>
        </div>
        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
          <button type="submit" class="btn btn-primary" style="flex: 1;">Save Changes</button>
          <button type="button" class="btn btn-secondary" onclick="closeModal('editMatchModal')" style="flex: 1;">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit Event Modal -->
  <div class="modal-overlay" id="editEventModal">
    <div class="modal glass" style="max-width: 600px; max-height: 90vh; overflow-y: auto;">
      <h3>Edit Entertainment Event</h3>
      <form id="editEventForm" style="margin-top: 1rem;">
        <div class="form-group">
          <label>Event Name</label>
          <input type="text" id="editEventName" style="background: white; color: black;">
        </div>
        <div class="grid grid-2" style="gap: 1rem;">
          <div class="form-group">
            <label>Event Date</label>
            <input type="date" id="editEventDate" style="background: white; color: black;">
          </div>
          <div class="form-group">
            <label>Event Type</label>
            <select id="editEventTypeSelect" style="background: white; color: black;"></select>
          </div>
        </div>
        <div class="grid grid-2" style="gap: 1rem;">
          <div class="form-group">
            <label>Venue</label>
            <input type="text" id="editEventVenue" style="background: white; color: black;">
          </div>
          <div class="form-group">
            <label>Base Ticket Price (EGP)</label>
            <input type="number" id="editEventPrice" min="0" style="background: white; color: black;">
          </div>
        </div>
        <div class="form-group">
          <label>Description</label>
          <textarea id="editEventDescription" style="min-height: 80px; resize: vertical; background: white; color: black;"></textarea>
        </div>
        <div class="form-group">
          <label>Google Maps Link</label>
          <input type="text" id="editEventMapUrl" style="background: white; color: black;">
        </div>
        <div class="form-group">
          <label>Header Image (leave blank to keep current)</label>
          <div class="drop-zone" id="editHeaderDropZone" onclick="document.getElementById('editHeaderFileInput').click()">
            <p>Drag & drop to replace header image</p>
            <input type="file" id="editHeaderFileInput" accept="image/*" style="display: none;">
            <div id="editHeaderPreview"></div>
          </div>
        </div>
        <div class="form-group">
          <label>Gallery Images (click to select to replace current)</label>
          <div class="drop-zone" id="editGalleryDropZone" onclick="document.getElementById('editGalleryFileInput').click()">
            <p>Drag & drop to replace gallery images</p>
            <input type="file" id="editGalleryFileInput" accept="image/*" multiple style="display: none;">
          </div>
          <div class="gallery-preview" id="editGalleryPreview"></div>
        </div>
        <div class="form-group" style="display: flex; align-items: center; gap: 0.5rem; margin-top: 1rem;">
          <input type="checkbox" id="editEventFeatured" style="width: auto;">
          <label for="editEventFeatured" style="margin: 0; cursor: pointer;">Feature on Home Page</label>
        </div>
        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
          <button type="submit" class="btn btn-primary" style="flex: 1;">Save Changes</button>
          <button type="button" class="btn btn-secondary" onclick="closeModal('editEventModal')" style="flex: 1;">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script>
    // ========================
    // CITIES & STADIUMS MAPPING
    // ========================
    const CITIES_STADIUMS = {
      'Cairo': ['Cairo Stadium', 'Petro Sport Stadium', 'Al Salam Stadium'],
      'Alexandria': ['Borg El Arab', 'Alexandria Stadium', 'Harras El-Hodoud Stadium'],
      'Ismailia': ['Ismailia Stadium'],
      'Suez': ['Suez Stadium', 'Army Stadium']
    };

    function getCityKey(dbCity) {
      if (!dbCity) return 'Cairo';
      const clean = dbCity.toLowerCase();
      if (clean.includes('cairo')) return 'Cairo';
      if (clean.includes('alexandria')) return 'Alexandria';
      if (clean.includes('ismailia')) return 'Ismailia';
      if (clean.includes('suez')) return 'Suez';
      return 'Cairo';
    }

    function updateStadiumOptions(citySelectId, stadiumSelectId, selectedStadium = null) {
      const citySelect = document.getElementById(citySelectId);
      const stadiumSelect = document.getElementById(stadiumSelectId);
      if (!citySelect || !stadiumSelect) return;

      const city = citySelect.value;
      const stadiums = CITIES_STADIUMS[city] || [];
      
      stadiumSelect.innerHTML = '';
      stadiums.forEach(st => {
        const option = document.createElement('option');
        option.value = st;
        option.textContent = st;
        if (selectedStadium && st.toLowerCase() === selectedStadium.toLowerCase()) {
          option.selected = true;
        }
        stadiumSelect.appendChild(option);
      });
    }

    // ========================
    // TEAMS DATABASE
    // ========================
    const TEAMS = [
      { name: 'Al Ahly FC', logo: 'egypt_al-ahly.football-logos.cc.svg' },
      { name: 'Al Ittihad Alexandria', logo: 'egypt_al-ittihad-alexandria.football-logos.cc.svg' },
      { name: 'Al Masry SC', logo: 'egypt_al-masry.football-logos.cc.svg' },
      { name: 'Al Mokawloon Al Arab', logo: 'egypt_al-mokawloon-al-arab.football-logos.cc.svg' },
      { name: 'Ceramica Cleopatra', logo: 'egypt_ceramica-cleopatra.football-logos.cc.svg' },
      { name: 'ENPPI', logo: 'egypt_enppi.football-logos.cc.svg' },
      { name: 'Ismaily SC', logo: 'egypt_ismaily.football-logos.cc.svg' },
      { name: 'Petrojet FC', logo: 'egypt_petrojet.football-logos.cc.svg' },
      { name: 'Pyramids FC', logo: 'egypt_pyramids.football-logos.cc.svg' },
      { name: 'Zamalek SC', logo: 'egypt_zamalek.football-logos.cc (2).svg' }
    ];

    let currentEditUserId = null;
    let headerFile = null;
    let galleryFiles = [];

    // ========================
    // DATA HELPERS (MongoDB Backend Integration)
    // ========================
    let globalBookingsList = [];

    window.loadAdminData = async () => {
      try {
        // Sync app state first
        await window.loadAppState();

        // Sync bookings/tickets
        const bookingsRes = await fetch('/api/bookings');
        const bookingsData = await bookingsRes.json();
        if (bookingsData.success) {
          globalBookingsList = bookingsData.tickets;
        }
      } catch (err) {
        console.error('Error synchronizing admin dashboard data:', err);
      }
    };

    function getUsers() { return STATE.users; }
    function getAdmins() { return STATE.admins; }
    function getAllTickets() {
      return globalBookingsList;
    }

    function adminLogout() { AppStorage.removeItem('loggedInAdmin'); window.location.href = '/login'; }
    function closeModal(id) { document.getElementById(id).style.display = 'none'; }

    async function switchAdminTab(evt, tabId) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.sidebar a').forEach(l => l.classList.remove('active'));
      if (evt && evt.target) {
        evt.target.classList.add('active');
      } else {
        const link = document.querySelector(`.sidebar a[onclick*="${tabId}"]`);
