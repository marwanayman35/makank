      existingHeaderImage = event.headerImage || '';
      existingGalleryImages = event.galleryImages ? [...event.galleryImages] : [];
      
      renderEditHeaderPreview();
      renderEditGalleryPreviews();

      document.getElementById('editEventFeatured').checked = !!event.featured;
      
      const today = new Date().toISOString().split('T')[0];
      document.getElementById('editEventDate').setAttribute('min', today);

      document.getElementById('editEventModal').style.display = 'flex';
    }

    document.addEventListener('DOMContentLoaded', async () => {
      if (!AppStorage.getItem('loggedInAdmin')) { window.location.href = '/login'; return; }
      await window.loadAdminData();
      renderAdminData();

      // Set min date to today for date pickers
      const today = new Date().toISOString().split('T')[0];
      document.getElementById('matchDate').setAttribute('min', today);
      document.getElementById('eventDate').setAttribute('min', today);

      // Setup image drag-and-drop for create forms
      setupDropZone('headerDropZone', 'headerFileInput', false, (file) => {
        headerFile = file;
        const objectUrl = URL.createObjectURL(file);
        document.getElementById('headerPreview').innerHTML = `
          <div class="image-preview-container">
            <img src="${objectUrl}" alt="Header Preview">
            <button type="button" class="delete-btn" onclick="removeHeaderFile()">×</button>
          </div>`;
      });
      setupDropZone('galleryDropZone', 'galleryFileInput', true, (file) => {
        galleryFiles.push(file);
        renderGalleryPreviews();
      });

      // Setup image drag-and-drop for edit forms
      setupDropZone('editHeaderDropZone', 'editHeaderFileInput', false, (file) => {
        editHeaderFile = file;
        renderEditHeaderPreview();
      });
      setupDropZone('editGalleryDropZone', 'editGalleryFileInput', true, (file) => {
        editGalleryFiles.push(file);
        renderEditGalleryPreviews();
      });

      // Create Admin form
      window.setupFormValidation('createAdminForm', {
        newAdminName: { required: true, type: 'name' }, newAdminEmail: { required: true, type: 'email' }, newAdminPassword: { required: true, minLength: 6 }
      }, async (form) => {
        const name = document.getElementById('newAdminName').value;
        const email = document.getElementById('newAdminEmail').value;
        const password = document.getElementById('newAdminPassword').value;
        const emailInput = document.getElementById('newAdminEmail');

        try {
          const response = await fetch('/api/auth/create-admin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ newAdminName: name, newAdminEmail: email, newAdminPassword: password })
          });
          const data = await response.json();
          if (data.success) {
            await window.loadAdminData();
            renderAdminData();
            form.reset();
            window.showToast('Admin created securely');
          } else {
            window.showError(emailInput, data.message || 'Admin email already exists');
          }
        } catch (err) {
          window.showToast('Network error creating admin.', 'error');
        }
      });

      // Add Football Match form
      window.setupFormValidation('matchForm', {
        matchHomeTeam: { required: true }, matchAwayTeam: { required: true },
        matchDate: { required: true, type: 'futureDate' }, matchTime: { required: true, type: 'time' }, matchStadium: { required: true }, matchCity: { required: true }, matchNumber: { required: true, type: 'numeric', minVal: 1 }
      }, async (form) => {
        const homeTeamName = document.getElementById('matchHomeTeam').value;
        const awayTeamName = document.getElementById('matchAwayTeam').value;
        if (homeTeamName === awayTeamName) { window.showToast('Home and Away teams cannot be the same!', 'error'); return; }
        const homeTeam = TEAMS.find(t => t.name === homeTeamName);
        const awayTeam = TEAMS.find(t => t.name === awayTeamName);
        
        const dateStr = (() => {
          const d = new Date(document.getElementById('matchDate').value + 'T00:00:00');
          const days = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
          const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
          return `${days[d.getDay()]} ${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`;
        })();

        try {
          const response = await fetch('/api/matches', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              homeTeam: homeTeam.name,
              homeTeamLogo: homeTeam.logo,
              awayTeam: awayTeam.name,
              awayTeamLogo: awayTeam.logo,
              date: dateStr,
              time: document.getElementById('matchTime').value,
              stadium: document.getElementById('matchStadium').value,
              city: document.getElementById('matchCity').value,
              matchNo: document.getElementById('matchNumber').value,
              status: document.getElementById('matchStatus').value,
              featured: document.getElementById('matchFeatured').checked
            })
          });
          const data = await response.json();
          if (data.success) {
            await window.loadAdminData();
            renderAdminData();
            form.reset();
            document.getElementById('matchFeatured').checked = false;
            window.showToast('Football match created successfully!');
            switchAdminTab(null, 'eventsListTab');
          } else {
            window.showToast(data.message || 'Error creating football match.', 'error');
          }
        } catch (err) {
          window.showToast('Network error creating football match.', 'error');
        }
      });

      // Add Entertainment Event form
      window.setupFormValidation('eventForm', {
        eventName: { required: true, type: 'name' }, eventDate: { required: true, type: 'futureDate' }, eventVenue: { required: true, type: 'name' }, eventPrice: { required: true, type: 'numeric' }, eventDescription: { required: true }, eventMapUrl: { type: 'url' }
      }, async (form) => {
        try {
          const formData = new FormData();
          formData.append('name', document.getElementById('eventName').value);
          formData.append('type', document.getElementById('eventTypeSelect').value);
          formData.append('date', document.getElementById('eventDate').value);
          formData.append('venue', document.getElementById('eventVenue').value);
          formData.append('price', document.getElementById('eventPrice').value);
          formData.append('description', document.getElementById('eventDescription').value);
          formData.append('mapUrl', document.getElementById('eventMapUrl').value);
          formData.append('featured', document.getElementById('eventFeatured').checked);

          if (headerFile) {
            formData.append('headerImage', headerFile);
          }
          galleryFiles.forEach(file => {
            formData.append('galleryImages', file);
          });

          const response = await fetch('/api/events', {
            method: 'POST',
            body: formData
          });
          const data = await response.json();
          if (data.success) {
            await window.loadAdminData();
            renderAdminData();
            form.reset();
            headerFile = null;
            galleryFiles = [];
            document.getElementById('headerPreview').innerHTML = '';
            document.getElementById('galleryPreview').innerHTML = '';
            document.getElementById('eventFeatured').checked = false;
            window.showToast('Entertainment event created successfully!');
            switchAdminTab(null, 'eventsListTab');
          } else {
            window.showToast(data.message || 'Error creating event.', 'error');
          }
        } catch (err) {
          window.showToast('Network error creating event.', 'error');
        }
      });
      // Edit Football Match Form submit
      window.setupFormValidation('editMatchForm', {
        editMatchHomeTeam: { required: true }, editMatchAwayTeam: { required: true },
        editMatchDate: { required: true, type: 'futureDate' }, editMatchTime: { required: true, type: 'time' }, editMatchStadium: { required: true }, editMatchCity: { required: true }, editMatchNumber: { required: true, type: 'numeric', minVal: 1 }
      }, async (form) => {
        const homeTeamName = document.getElementById('editMatchHomeTeam').value;
        const awayTeamName = document.getElementById('editMatchAwayTeam').value;
        if (homeTeamName === awayTeamName) { window.showToast('Home and Away teams cannot be the same!', 'error'); return; }
        
        const homeTeam = TEAMS.find(t => t.name === homeTeamName);
        const awayTeam = TEAMS.find(t => t.name === awayTeamName);
        
        const dateStr = (() => {
          const val = document.getElementById('editMatchDate').value;
          if (val.includes('-')) {
            const d = new Date(val + 'T00:00:00');
            const days = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
            const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
            return `${days[d.getDay()]} ${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`;
          }
          return val;
        })();

        try {
          const response = await fetch(`/api/matches/edit/${encodeURIComponent(currentEditMatchId)}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              homeTeam: homeTeam.name,
              homeTeamLogo: homeTeam.logo,
              awayTeam: awayTeam.name,
              awayTeamLogo: awayTeam.logo,
              date: dateStr,
              time: document.getElementById('editMatchTime').value,
              stadium: document.getElementById('editMatchStadium').value,
              city: document.getElementById('editMatchCity').value,
              matchNo: document.getElementById('editMatchNumber').value,
              status: document.getElementById('editMatchStatus').value,
              featured: document.getElementById('editMatchFeatured').checked
            })
          });
          const data = await response.json();
          if (data.success) {
            await window.loadAdminData();
            renderAdminData();
            closeModal('editMatchModal');
            window.showToast('Match updated successfully!');
          } else {
            window.showToast(data.message || 'Error updating match.', 'error');
          }
        } catch (err) {
          window.showToast('Network error updating match.', 'error');
        }
      });

      // Edit Entertainment Event Form submit
      window.setupFormValidation('editEventForm', {
        editEventName: { required: true, type: 'name' }, editEventDate: { required: true, type: 'futureDate' }, editEventVenue: { required: true, type: 'name' }, editEventPrice: { required: true, type: 'numeric' }, editEventDescription: { required: true }, editEventMapUrl: { type: 'url' }
      }, async (form) => {
        try {
          const formData = new FormData();
          formData.append('name', document.getElementById('editEventName').value);
          formData.append('type', document.getElementById('editEventTypeSelect').value);
          formData.append('date', document.getElementById('editEventDate').value);
          formData.append('venue', document.getElementById('editEventVenue').value);
          formData.append('price', document.getElementById('editEventPrice').value);
          formData.append('description', document.getElementById('editEventDescription').value);
          formData.append('mapUrl', document.getElementById('editEventMapUrl').value);
          formData.append('featured', document.getElementById('editEventFeatured').checked);

          if (editHeaderFile) {
            formData.append('headerImage', editHeaderFile);
          } else {
            formData.append('existingHeaderImage', existingHeaderImage);
          }

          formData.append('existingGalleryImages', JSON.stringify(existingGalleryImages));

          editGalleryFiles.forEach(file => {
            formData.append('galleryImages', file);
          });

          const response = await fetch(`/api/events/edit/${encodeURIComponent(currentEditEventId)}`, {
            method: 'POST',
            body: formData
          });
          const data = await response.json();
          if (data.success) {
            await window.loadAdminData();
            renderAdminData();
            closeModal('editEventModal');
            window.showToast('Event updated successfully!');
          } else {
            window.showToast(data.message || 'Error updating event.', 'error');
          }
        } catch (err) {
          window.showToast('Network error updating event.', 'error');
        }
      });
    });
  </script>
</body>
</html>
