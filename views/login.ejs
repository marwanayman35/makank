<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Login - Makank' }) %>
<style>
  .auth-container {
    max-width: 480px;
    margin: 4rem auto;
    padding: 3rem;
    transition: all 0.3s ease;
  }
</style>
<body>
  <div class="bg-blobs"></div>

  <%- include('partials/navbar', { activePage: 'login' }) %>

  <main class="container">
    <div class="glass auth-container animate fade-in" id="authBox">
      <h2 class="text-center" style="margin-bottom: 2rem;">Welcome <span class="text-gradient">Back</span></h2>
      <form id="loginForm">
        <div class="form-group">
          <label>Email Address</label>
          <input type="email" id="email" placeholder="you@example.com">
        </div>
        <div class="form-group">
          <label>Password</label>
          <div class="password-container">
            <input type="password" id="password" placeholder="Enter your password">
            <img src="https://cdn-icons-png.flaticon.com/512/159/159604.png" alt="Show Password" class="toggle-password" onclick="togglePasswordVisibility('password', this)">
          </div>
        </div>
        <div class="form-group" style="display: flex; align-items: center; gap: 0.5rem; margin-top: -0.5rem;">
          <input type="checkbox" id="rememberMe" style="width: auto;">
          <label for="rememberMe" style="margin: 0; color: var(--text-secondary); font-size: 0.9rem;">Remember me</label>
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">Log In</button>
      </form>
      <p class="text-center" style="margin-top: 2rem; font-size: 0.9rem;">
        Don't have an account? <a href="/register" style="color: var(--accent-cyan); font-weight: 600;">Register here</a>
      </p>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
  <script>
    function togglePasswordVisibility(inputId, iconEl) {
      const input = document.getElementById(inputId);
      const showIcon = "https://cdn-icons-png.flaticon.com/512/159/159604.png";
      const hideIcon = "https://cdn-icons-png.flaticon.com/512/565/565655.png";
      
      if (input.type === "password") {
        input.type = "text";
        iconEl.src = hideIcon;
      } else {
        input.type = "password";
        iconEl.src = showIcon;
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      // Auto-Fill Remember Me
      const savedEmail = AppStorage.getItem('rememberedEmail');
      if (savedEmail) {
        document.getElementById('email').value = savedEmail;
        document.getElementById('rememberMe').checked = true;
      }

      // Login Form Submit
      window.setupFormValidation('loginForm', {
        email: { required: true, type: 'email' },
        password: { required: true }
      }, async (form) => {
        window.clearError(document.getElementById('email'));
        window.clearError(document.getElementById('password'));

        const email = document.getElementById('email').value.trim();
        const password = document.getElementById('password').value;
        const pwdInput = document.getElementById('password');
        
        try {
          const response = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password })
          });
          const data = await response.json();

          if (data.success) {
            if (document.getElementById('rememberMe').checked) {
              AppStorage.setItem('rememberedEmail', email);
            } else {
              AppStorage.removeItem('rememberedEmail');
            }

            if (data.isAdmin) {
              // Store admin and clean up user state
              AppStorage.removeItem('loggedInUser');
              AppStorage.setItem('loggedInAdmin', JSON.stringify(data.admin));
              window.showToast('Admin login successful!');
              setTimeout(() => window.location.href = '/admin', 1000);
            } else {
              // Store user and clean up admin state
              AppStorage.removeItem('loggedInAdmin');
              AppStorage.setItem('loggedInUser', JSON.stringify(data.user));
              window.showToast('Login successful!');
              setTimeout(() => window.location.href = '/user', 1500);
            }
          } else {
            window.showError(pwdInput, data.message || 'Incorrect password or account not found.');
          }
        } catch (err) {
          window.showToast('Authentication network error.', 'error');
        }
      });
    });
  </script>
</body>
</html>
