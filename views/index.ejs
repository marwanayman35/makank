<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Makank - Premium Event Booking' }) %>
<body>
  <!-- Animated Background -->
  <div class="bg-blobs"></div>

  <!-- Navigation -->
  <%- include('partials/navbar', { activePage: 'home' }) %>

  <main>
    <!-- Hero Section -->
    <section class="hero container">
      <div class="hero-content animate delay-1" style="max-width: 580px;">
        <h1 data-i18n="hero_title">Find Your <span class="text-gradient">Next Ticket</span>.</h1>
        <p data-i18n="hero_subtitle">Your exclusive pass to the best live events in Egypt. Book tickets for top local football matches and legendary concerts today.</p>
        <form action="/events" method="GET" style="display: flex; gap: 1rem; margin-top: 2rem; background: rgba(255, 255, 255, 0.95); padding: 0.5rem 0.5rem 0.5rem 1.5rem; border-radius: 50px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
          <input type="text" name="q" placeholder="Search events, artists..." data-i18n-placeholder="search_placeholder" style="flex: 1; border: none; background: transparent; color: black; font-weight: 500; font-size: 1.1rem; outline: none;">
          <button type="submit" class="btn btn-primary" style="border-radius: 50px; padding: 0.8rem 2rem;" data-i18n="search_btn">Search</button>
        </form>
      </div>
      <div class="hero-image animate delay-2">
        <img src="/assets/hero section main.png" alt="Hero Visual" style="width: 110%; max-width: 900px; height: auto; filter: drop-shadow(0 24px 48px rgba(0,0,0,0.18)); transform: translateY(-20px); margin-left: 80px;">
      </div>
    </section>

    <!-- Top Categories -->
    <section class="container animate delay-2">
      <h2 style="margin-bottom: 2rem;" data-i18n="browse_categories">Browse <span class="text-gradient">Categories</span></h2>
      <div class="grid grid-2" id="categoriesContainer">
        <!-- Rendered by JS -->
      </div>
    </section>

    <!-- Upcoming Events Section -->
    <section class="container animate delay-2" style="margin-top: 3rem;">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem;">
        <h2 data-i18n="upcoming_events">Upcoming <span class="text-gradient">Events</span></h2>
        <a href="/categories" style="color: var(--accent-cyan); font-weight: bold; font-size: 0.9rem;" data-i18n="view_all">View All &rarr;</a>
      </div>
      <div class="grid grid-3" id="featuredContainer">
        <!-- Rendered by JS -->
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', async () => {
       await window.loadAppState();
       renderIndexContent();
    });

    window.addEventListener('languagechange', () => {
       renderIndexContent();
    });

    function renderIndexContent() {
       const isAr = window.getCurrentLanguage() === 'ar';
       
       // Render Categories
       const catContainer = document.getElementById('categoriesContainer');
       if (!catContainer) return;
       catContainer.innerHTML = '';
       
       STATE.eventTypes.forEach(cat => {
          let bgImage = cat.toLowerCase() === 'football' ? 'football.png' : 'concert.jpg';
          let linkUrl = cat.toLowerCase() === 'football' ? '/sports' : '/events';
          let displayName = cat;
          if (isAr) {
             displayName = cat.toLowerCase() === 'football' ? 'مباريات كرة القدم' : 'حفلات ترفيهية';
          }
          catContainer.innerHTML += `
            <a href="${linkUrl}" class="glass" style="display: block; text-decoration: none; overflow: hidden; border-radius: 24px; transition: transform 0.3s;">
              <div style="background: url('/assets/images/${bgImage}') center/cover; width: 100%; aspect-ratio: 16/10;"></div>
              <div style="padding: 1.8rem 1.5rem; text-align: center;">
                <h3 style="text-transform: capitalize; margin: 0; font-size: 1.3rem;">${displayName}</h3>
              </div>
            </a>
          `;
       });

       // Render Featured / Upcoming Events (real data from admin)
       const featuredContainer = document.getElementById('featuredContainer');
       if (!featuredContainer) return;
       featuredContainer.innerHTML = '';
       
       // Gather featured entertainment events
       const featuredEvents = STATE.events.filter(ev => ev.featured === true);
       
       // Gather featured matches
       const featuredMatches = STATE.matches.filter(m => m.featured === true);

       const hasAny = featuredEvents.length > 0 || featuredMatches.length > 0;

       if (!hasAny) {
         const noTitle = isAr ? 'لا توجد فعاليات مميزة حالياً' : 'No Featured Events Yet';
         const noDesc = isAr ? 'تصفح الموقع لاحقاً لمتابعة أحدث الفعاليات المميزة!' : 'Check back soon for upcoming highlighted events!';
         featuredContainer.innerHTML = `
           <div class="glass" style="padding: 3rem; text-align: center; grid-column: 1 / -1; border: 1px dashed var(--border-glass);">
             <h3 style="color: var(--text-secondary); margin-bottom: 0.5rem;">${noTitle}</h3>
             <p style="color: rgba(255,255,255,0.4);">${noDesc}</p>
           </div>`;
         return;
       }

       // Render featured matches
       featuredMatches.forEach(m => {
         const badgeText = isAr ? 'كرة قدم' : 'Football';
         const viewText = isAr ? 'عرض المباراة' : 'View Match';
         featuredContainer.innerHTML += `
           <div class="glass" style="overflow: hidden; border-radius: 24px; transition: transform 0.3s;">
             <div style="background: url('/assets/images/football.png') center/cover; width: 100%; aspect-ratio: 16/10; position: relative;">
               <div style="position: absolute; bottom: 10px; left: 10px; display: flex; gap: 5px;">
                 <img src="/assets/Football%20Matches/${encodeURIComponent(m.homeTeamLogo)}" style="width: 40px; height: 40px; border-radius: 50%; background: white; padding: 3px; object-fit: contain; border: 2px solid var(--accent-cyan);" alt="${m.homeTeam}">
                 <img src="/assets/Football%20Matches/${encodeURIComponent(m.awayTeamLogo)}" style="width: 40px; height: 40px; border-radius: 50%; background: white; padding: 3px; object-fit: contain; border: 2px solid var(--accent-purple);" alt="${m.awayTeam}">
               </div>
             </div>
             <div style="padding: 1.5rem 1.8rem;">
               <span class="badge badge-cyan">${badgeText}</span>
               <h3>${m.homeTeam} vs ${m.awayTeam}</h3>
               <p style="color: var(--text-secondary); font-size: 0.9rem;">${m.stadium} | ${m.date}</p>
               <a href="/sports" class="btn btn-secondary" style="width: 100%; margin-top: 1rem; text-align: center; display: block;">${viewText}</a>
             </div>
           </div>
         `;
       });

       // Render featured entertainment events
       featuredEvents.forEach(ev => {
         const heroImg = ev.headerImage || `/assets/images/${ev.type === 'football' ? 'football.png' : 'concert.jpg'}`;
         const badgeText = isAr ? (ev.type === 'concert' ? 'حفل موسيقائي' : ev.type) : (ev.type.charAt(0).toUpperCase() + ev.type.slice(1));
         const viewText = isAr ? 'عرض التفاصيل' : 'View Details';
         featuredContainer.innerHTML += `
           <div class="glass" style="overflow: hidden; border-radius: 24px; transition: transform 0.3s;">
             <div style="background: url('${heroImg}') center/cover; width: 100%; aspect-ratio: 16/10;"></div>
             <div style="padding: 1.5rem 1.8rem;">
               <span class="badge badge-purple" style="text-transform: capitalize;">${badgeText}</span>
               <h3>${ev.name}</h3>
               <p style="color: var(--text-secondary); font-size: 0.9rem;">${ev.venue} | ${ev.date}</p>
               <a href="/event-details?id=${encodeURIComponent(ev.id)}" class="btn btn-secondary" style="width: 100%; margin-top: 1rem; text-align: center; display: block;">${viewText}</a>
             </div>
           </div>
         `;
       });
    }
  </script>
</body>
</html>
